<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TikSave Ultimate</title>
<style>
*{box-sizing:border-box}
:root{
--bg:#f4f5f7;
--surface:#fff;
--ink:#111318;
--muted:#777c86;
--line:#e5e7eb;
--soft:#f7f8fa;
--accent:#111827;
--green:#15803d
}
body{
margin:0;
font-family:Inter,"Segoe UI",Tahoma,Arial,sans-serif;
background:var(--bg);
color:var(--ink);
-webkit-font-smoothing:antialiased
}
button,input,select{font:inherit}
button{cursor:pointer}
.top{
height:74px;
border-bottom:1px solid var(--line);
background:rgba(255,255,255,.88);
backdrop-filter:blur(18px);
display:flex;
align-items:center;
justify-content:space-between;
padding:0 max(22px,calc((100% - 1180px)/2))
}
.brand{
display:flex;
align-items:center;
gap:10px;
font-size:21px;
font-weight:850;
letter-spacing:-.8px
}
.brandmark{
width:38px;height:38px;border-radius:11px;
background:#111;color:#fff;
display:grid;place-items:center;
font-weight:900
}
.nav{
display:flex;
gap:8px;
font-size:12px;
color:#777
}
.nav span{
padding:8px 12px;
border-radius:8px
}
.wrap{
max-width:1180px;
margin:auto;
padding:62px 22px 70px
}
.hero{
display:grid;
grid-template-columns:1fr 520px;
gap:70px;
align-items:center;
min-height:570px
}
.eyebrow{
font-size:11px;
font-weight:800;
letter-spacing:2px;
color:#9a9da3;
margin-bottom:19px
}
h1{
font-size:clamp(48px,6vw,82px);
line-height:.97;
letter-spacing:-5px;
margin:0 0 25px;
font-weight:900
}
h1 span{color:#9a9da3}
.lead{
max-width:570px;
font-size:16px;
line-height:1.9;
color:#777c86;
margin:0 0 30px
}
.points{
display:flex;
flex-wrap:wrap;
gap:16px;
font-size:11px;
color:#70757d
}
.points span:before{
content:"✓";
font-weight:900;
color:#111;
margin-left:6px
}
.app{
background:#fff;
border:1px solid #dedfe3;
border-radius:24px;
padding:9px;
box-shadow:0 30px 80px rgba(17,24,39,.10)
}
.app-head{
height:38px;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 9px;
font-size:10px;
color:#999
}
.lights{
display:flex;
gap:5px
}
.lights i{
width:7px;height:7px;
border-radius:50%;
background:#ddd
}
.workspace{
border:1px solid #e7e8ea;
border-radius:17px;
padding:20px;
background:#fafafa
}
.input-box{
background:#fff;
border:1px solid #dddfe3;
border-radius:16px;
padding:7px;
display:flex;
gap:7px;
box-shadow:0 7px 25px rgba(0,0,0,.04)
}
.input-box input{
flex:1;
min-width:0;
border:0;
outline:0;
height:51px;
padding:0 13px;
direction:ltr;
text-align:left;
background:transparent;
font-size:13px
}
.input-box input::placeholder{color:#aaa}
.analyze{
border:0;
background:#111827;
color:#fff;
padding:0 22px;
border-radius:11px;
font-weight:750;
font-size:12px
}
.analyze:hover{background:#272b33}
.drop{
height:43px;
border:1px dashed #d4d6da;
border-radius:12px;
margin-top:9px;
display:flex;
align-items:center;
justify-content:center;
font-size:10px;
color:#a0a4aa;
transition:.2s
}
.drop.active{
border-color:#111;
background:#f0f1f3;
color:#222
}
.result{
display:none;
margin-top:14px;
background:#fff;
border:1px solid #e0e1e4;
border-radius:16px;
padding:15px
}
.result.show{display:block}
.video{
display:flex;
gap:12px;
align-items:center
}
.thumb{
width:108px;
height:75px;
object-fit:cover;
border-radius:11px;
background:#eee
}
.vinfo{min-width:0;flex:1}
.vtitle{
font-size:13px;
font-weight:800;
line-height:1.55;
display:-webkit-box;
-webkit-line-clamp:2;
-webkit-box-orient:vertical;
overflow:hidden
}
.vmeta{
font-size:10px;
color:#999;
margin-top:6px
}
.qualities{
display:flex;
gap:6px;
overflow-x:auto;
padding:13px 0 4px
}
.q{
border:1px solid #ddd;
background:#fff;
border-radius:9px;
padding:9px 12px;
font-size:10px;
white-space:nowrap
}
.q.active{
background:#111827;
color:#fff;
border-color:#111827
}
.downloads{
display:grid;
grid-template-columns:1fr 105px;
gap:7px;
margin-top:8px
}
.dl{
height:45px;
border:0;
border-radius:10px;
background:#111827;
color:#fff;
font-size:11px;
font-weight:800
}
.mp3{
height:45px;
border:1px solid #ddd;
border-radius:10px;
background:#f7f7f6;
color:#222;
font-size:11px;
font-weight:750
}
.state{
margin-top:12px;
display:none;
padding:11px;
border-radius:10px;
background:#f6f7f8;
font-size:10px
}
.state.show{display:block}
.state-row{
display:flex;
justify-content:space-between;
margin-bottom:8px
}
.state-label{font-weight:750}
.state-percent{color:#777}
.progress{
height:5px;
border-radius:99px;
background:#e5e7eb;
overflow:hidden
}
.bar{
height:100%;
width:0;
background:#111827;
transition:width .3s
}
.error{
display:none;
margin-top:10px;
padding:11px;
border-radius:10px;
background:#fef2f2;
color:#991b1b;
font-size:10px;
line-height:1.7
}
.error.show{display:block}
.ready{
display:none;
margin-top:10px;
padding:11px;
border-radius:10px;
background:#f0fdf4;
color:#166534;
font-size:10px;
justify-content:space-between;
align-items:center;
gap:10px
}
.ready.show{display:flex}
.save{
border:0;
background:#166534;
color:#fff;
border-radius:8px;
padding:8px 13px;
font-size:10px;
font-weight:750
}
.steps{
margin-top:85px;
border-top:1px solid #dddfe2;
padding-top:28px;
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px
}
.step{
min-height:130px
}
.num{
font-size:10px;
color:#aaa;
margin-bottom:18px
}
.step h3{
margin:0 0 7px;
font-size:13px
}
.step p{
margin:0;
font-size:11px;
color:#92969d;
line-height:1.8
}
.footer{
border-top:1px solid #dddfe2;
padding:23px;
text-align:center;
font-size:10px;
color:#999
}
@media(max-width:900px){
.hero{
grid-template-columns:1fr;
gap:45px
}
.app{max-width:650px;width:100%;margin:auto}
}
@media(max-width:600px){
.top{height:66px;padding:0 16px}
.nav{display:none}
.wrap{padding:42px 16px 55px}
h1{
font-size:51px;
letter-spacing:-3px
}
.lead{font-size:14px}
.input-box{display:block}
.input-box input{
width:100%;
height:50px
}
.analyze{
width:100%;
height:47px
}
.drop{display:none}
.workspace{padding:12px}
.video{align-items:flex-start}
.thumb{
width:92px;
height:68px
}
.downloads{
grid-template-columns:1fr 92px
}
.steps{
grid-template-columns:1fr 1fr;
margin-top:60px
}
}
</style>
