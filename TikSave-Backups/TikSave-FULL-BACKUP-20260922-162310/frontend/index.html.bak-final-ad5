<script>
let currentUrl="";
let selectedQuality="720";
let currentJob="";
let pollTimer=null;

const $=id=>document.getElementById(id);

function showError(message){
$("error").textContent=message;
$("error").classList.add("show");
$("ready").classList.remove("show");
}

function clearMessages(){
$("error").classList.remove("show");
$("ready").classList.remove("show");
}

async function analyze(){

const url=$("url").value.trim();

if(!url){
showError("أدخل رابط الفيديو أولاً");
$("result").classList.add("show");
return;
}

currentUrl=url;
clearMessages();

$("result").classList.add("show");
$("title").textContent="جاري تحليل الفيديو...";
$("meta").textContent="الاتصال بالمصدر...";
$("thumb").removeAttribute("src");
$("qualities").innerHTML="";

try{

const response=await fetch("/api/info",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({url:url})
});

const data=await response.json();

if(!response.ok){
throw new Error(data.error||"تعذر تحليل الرابط");
}

$("title").textContent=data.title||"فيديو";
$("meta").textContent=
(data.uploader?data.uploader+" • ":"")+
(data.duration?"المدة "+data.duration:"جاهز");

if(data.thumbnail){
$("thumb").src=data.thumbnail;
}

const qs=(data.qualities&&data.qualities.length)
?data.qualities:[1080,720,480,360];

let unique=[...new Set(qs.map(Number))];

if(!unique.includes(720))unique.push(720);

unique.sort((a,b)=>b-a);

$("qualities").innerHTML=unique.map((q,i)=>
`<button class="q ${q==720?"active":""}" data-q="${q}">
${q}p
</button>`
).join("");

document.querySelectorAll(".q").forEach(btn=>{
btn.onclick=()=>{
document.querySelectorAll(".q").forEach(x=>x.classList.remove("active"));
btn.classList.add("active");
selectedQuality=btn.dataset.q;
};
});

}catch(e){
$("title").textContent="تعذر تحليل الفيديو";
$("meta").textContent="تحقق من الرابط وحاول مرة أخرى";
showError(e.message||"حدث خطأ غير معروف");
}
}

async function startDownload(audio){

if(!currentUrl){
showError("حلّل الرابط أولاً");
return;
}

clearMessages();

$("state").classList.add("show");
$("stateLabel").textContent=audio?"جاري تجهيز الصوت...":"جاري تجهيز الفيديو...";
$("percent").textContent="0%";
$("bar").style.width="0%";

try{

let endpoint="/api/download?url="+
encodeURIComponent(currentUrl);

if(audio){
endpoint+="&audio=1";
}else{
endpoint+="&quality="+encodeURIComponent(selectedQuality);
}

const response=await fetch(endpoint);

const data=await response.json();

if(!response.ok){
throw new Error(data.error||"تعذر بدء التحميل");
}

currentJob=data.id;

pollStatus();

}catch(e){
$("state").classList.remove("show");
showError(e.message||"تعذر بدء التحميل");
}
}

async function pollStatus(){

if(!currentJob)return;

try{

const response=await fetch(
"/api/status?id="+encodeURIComponent(currentJob)
);

const data=await response.json();

const status=data.status||"";

if(status==="starting"){
setState("جاري بدء العملية...",5);
}
else if(status==="preparing"){
setState("جاري تجهيز الملف...",12);
}
else if(status==="downloading"){
const p=Number(data.percent||0);
setState("جاري تحميل الفيديو...",Math.max(1,Math.min(p,98)));

if(data.speed){
const mb=(data.speed/1024/1024).toFixed(1);
$("stateLabel").textContent=
"جاري التحميل • "+mb+" MB/s";
}
}
else if(status==="processing"){
setState("جاري تجهيز الملف النهائي...",99);
}
else if(status==="ready"){
setState("اكتمل التحميل",100);
$("ready").classList.add("show");
return;
}
else if(status==="error"){
$("state").classList.remove("show");
showError(data.error||"حدث خطأ أثناء التحميل");
return;
}

pollTimer=setTimeout(pollStatus,700);

}catch(e){
pollTimer=setTimeout(pollStatus,1200);
}
}

function setState(label,value){
$("stateLabel").textContent=label;
$("percent").textContent=Math.round(value)+"%";
$("bar").style.width=Math.max(0,Math.min(100,value))+"%";
}

function saveFile(){

if(!currentJob)return;

window.location.href=
"/api/file?id="+encodeURIComponent(currentJob);
}

$("url").addEventListener("keydown",e=>{
if(e.key==="Enter")analyze();
});

const drop=$("drop");

drop.addEventListener("dragover",e=>{
e.preventDefault();
drop.classList.add("active");
});

drop.addEventListener("dragleave",()=>{
drop.classList.remove("active");
});

drop.addEventListener("drop",e=>{
e.preventDefault();
drop.classList.remove("active");

const text=e.dataTransfer.getData("text").trim();

if(text){
$("url").value=text;
analyze();
}
});
</script>

<style>.new-video-btn{display:block;width:100%;margin-top:14px;height:58px;border:1px solid #ddd;background:#fff;color:#111;border-radius:16px;font-size:18px;font-weight:800;cursor:pointer}.new-video-btn:hover{background:#f5f5f5}</style><script>function newVideo(){var u=document.getElementById("url");if(u)u.value="";var r=document.getElementById("result");if(r)r.style.display="none";window.scrollTo({top:0,behavior:"smooth"});if(u)setTimeout(function(){u.focus()},400)}</script><script>
(function(){
function TikSaveNewVideo(){
    try{
        if(window.tikAdTimer){clearInterval(window.tikAdTimer);}
    }catch(e){}

    document.querySelectorAll("[id]").forEach(function(el){
        if(el.id==="tikAdModal") el.style.display="none";
    });

    document.querySelectorAll(".progress").forEach(function(el){
        el.style.display="none";
    });

    document.querySelectorAll(".ready").forEach(function(el){
        el.style.display="none";
    });

    document.querySelectorAll(".result").forEach(function(el){
        el.style.display="none";
    });

    document.querySelectorAll(".bar").forEach(function(el){
        el.style.width="0%";
    });

    document.querySelectorAll(".percent").forEach(function(el){
        el.textContent="0%";
    });

    const url=document.getElementById("url");

    if(url){
        url.value="";
        url.removeAttribute("disabled");
        url.removeAttribute("readonly");

        setTimeout(function(){
            url.focus();
            window.scrollTo({
                top:0,
                behavior:"smooth"
            });
        },100);
    }

    window.currentUrl="";
    window.oldUrl="";
    window.currentJob="";
    window.oldJob="";
}

window.newVideo=TikSaveNewVideo;

document.addEventListener("click",function(e){
    const btn=e.target.closest("button,a");

    if(!btn)return;

    const text=(btn.textContent||"").trim();

    if(
        text.includes("تحميل فيديو آخر") ||
        text.includes("تحميل فيديو اخر")
    ){
        e.preventDefault();
        e.stopImmediatePropagation();
        TikSaveNewVideo();
    }
},true);
})();
</script><div class="ts-ad">مساحة إعلانية</div></body>
