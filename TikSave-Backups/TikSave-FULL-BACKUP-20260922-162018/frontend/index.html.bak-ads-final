<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>TikSave — تحميل الفيديوهات</title>
<meta name="description" content="TikSave لتحميل الفيديوهات بسهولة وسرعة">
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:Arial,"Segoe UI",sans-serif;background:#fff;color:#171717;min-height:100vh}
header{height:76px;border-bottom:1px solid #eee;display:flex;align-items:center;justify-content:space-between;padding:0 6%;background:#fff;position:sticky;top:0;z-index:10}
.logo{display:flex;align-items:center;gap:10px;font-size:25px;font-weight:800;color:#ff3f8e;text-decoration:none}
.logoIcon{width:38px;height:38px;border-radius:12px;background:#ff3f8e;color:#fff;display:grid;place-items:center;font-size:20px;box-shadow:0 8px 20px rgba(255,63,142,.18)}
.lang{border:1px solid #e8e8e8;border-radius:12px;padding:10px 13px;background:#fff;font-size:14px;outline:none}
main{max-width:1050px;margin:auto;padding:65px 20px 40px}
.hero{text-align:center}
.badge{display:inline-block;padding:7px 14px;border:1px solid #ffd0e2;border-radius:30px;color:#ff3f8e;background:#fff8fb;font-size:13px;font-weight:700}
h1{font-size:clamp(38px,6vw,68px);line-height:1.05;margin:20px 0 14px;letter-spacing:-2px}
h1 span{color:#ff3f8e}
.sub{font-size:18px;color:#777;max-width:650px;margin:0 auto 32px;line-height:1.8}
.searchBox{max-width:800px;margin:0 auto;background:#fff;border:1px solid #e8e8e8;border-radius:20px;padding:8px;display:flex;gap:8px;box-shadow:0 18px 50px rgba(0,0,0,.07)}
.searchBox input{flex:1;border:0;outline:0;padding:17px;font-size:16px;direction:ltr;border-radius:14px;min-width:0}
.downloadBtn{border:0;background:#ff3f8e;color:#fff;border-radius:15px;padding:0 27px;font-size:16px;font-weight:800;cursor:pointer;min-height:54px;transition:.2s}
.downloadBtn:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(255,63,142,.25)}
.tsAd{max-width:800px;height:90px;border:1px dashed #ddd;border-radius:16px;margin:25px auto;display:grid;place-items:center;color:#aaa;font-size:13px;background:#fafafa}
.features{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:35px}
.card{border:1px solid #eee;border-radius:18px;padding:22px;background:#fff;text-align:center}
.cardIcon{font-size:27px;margin-bottom:8px}
.card b{display:block;margin-bottom:7px}
.card p{margin:0;color:#777;font-size:14px;line-height:1.7}
#result{margin:25px auto;max-width:800px}
.videoCard{border:1px solid #eee;border-radius:20px;padding:18px;text-align:right;box-shadow:0 12px 35px rgba(0,0,0,.05)}
.videoCard img{width:180px;height:105px;object-fit:cover;border-radius:12px;float:right;margin-left:15px}
.videoCard h3{margin:4px 0 12px}
.quality{border:1px solid #ddd;border-radius:10px;padding:10px;background:#fff}
.clear{clear:both}
.tsGate{display:none;position:fixed;inset:0;background:rgba(255,255,255,.88);backdrop-filter:blur(8px);z-index:100;align-items:center;justify-content:center;padding:20px}
.tsGateBox{background:#fff;border:1px solid #eee;border-radius:24px;width:min(420px,100%);padding:30px;text-align:center;box-shadow:0 25px 80px rgba(0,0,0,.15)}
.tsGateBox b{font-size:20px}
.tsGateSpace{height:100px;background:#fafafa;border:1px dashed #ddd;border-radius:14px;margin:20px 0;display:grid;place-items:center;color:#aaa}
#tsGateText{color:#777;margin-bottom:12px}
#tsGateBtn{border:0;background:#ff3f8e;color:#fff;border-radius:12px;padding:13px 22px;font-weight:700;cursor:pointer}
#tsGateBtn:disabled{opacity:.45;cursor:not-allowed}
footer{text-align:center;border-top:1px solid #eee;padding:28px;color:#999;font-size:13px;margin-top:50px}
@media(max-width:700px){
header{padding:0 18px}
main{padding:42px 15px 25px}
.searchBox{flex-direction:column;padding:7px}
.downloadBtn{min-height:52px}
.features{grid-template-columns:1fr}
h1{letter-spacing:-1px}
.videoCard img{float:none;width:100%;height:190px;margin:0 0 12px}
}
</style>
</head>
<body>
<header>
<a class="logo" href="#"><span class="logoIcon">↓</span>TikSave</a>
<select id="language" class="lang" onchange="changeLanguage(this.value)">
<option value="ar">العربية</option>
<option value="en">English</option>
<option value="tr">Türkçe</option>
<option value="fr">Français</option>
<option value="es">Español</option>
<option value="de">Deutsch</option>
</select>
</header>

<main>
<section class="hero">
<div class="badge" id="badge">تحميل سريع وسهل</div>
<h1 id="title">حمّل فيديوهاتك مع <span>TikSave</span></h1>
<p class="sub" id="subtitle">ألصق رابط الفيديو واحصل على خيارات التحميل بجودة عالية وبواجهة بسيطة وسريعة.</p>

<div class="searchBox">
<input id="url" type="url" placeholder="ألصق رابط الفيديو هنا..." autocomplete="off">
<button class="downloadBtn" onclick="startDownload()" id="downloadBtn">تحميل الفيديو</button>
</div>

<div class="tsAd">مساحة إعلانية</div>
<div id="result"></div>

<div class="features">
<div class="card"><div class="cardIcon">⚡</div><b id="f1">سرعة عالية</b><p id="f1p">واجهة خفيفة وسريعة للحصول على الفيديو بأقل خطوات.</p></div>
<div class="card"><div class="cardIcon">◉</div><b id="f2">جودات متعددة</b><p id="f2p">اختر الجودة المناسبة حسب الفيديو والإمكانيات المتاحة.</p></div>
<div class="card"><div class="cardIcon">🔒</div><b id="f3">بسيط وواضح</b><p id="f3p">بدون تعقيد، الصق الرابط واضغط تحميل.</p></div>
</div>
</section>
</main>

<div id="tsGate" class="tsGate">
<div class="tsGateBox">
<b id="adTitle">إعلان</b>
<div class="tsGateSpace">مساحة إعلانية</div>
<div id="tsGateText">انتظر 5 ثوانٍ...</div>
<br>
<button id="tsGateBtn" disabled onclick="continueDownload()">متابعة التحميل</button>
</div>
</div>

<footer id="footer">TikSave © 2026 — أداة تحميل سهلة وسريعة</footer>

<script>
const translations={
ar:{dir:"rtl",badge:"تحميل سريع وسهل",title:'حمّل فيديوهاتك مع <span>TikSave</span>',subtitle:"ألصق رابط الفيديو واحصل على خيارات التحميل بجودة عالية وبواجهة بسيطة وسريعة.",placeholder:"ألصق رابط الفيديو هنا...",button:"تحميل الفيديو",f1:"سرعة عالية",f1p:"واجهة خفيفة وسريعة للحصول على الفيديو بأقل خطوات.",f2:"جودات متعددة",f2p:"اختر الجودة المناسبة حسب الفيديو والإمكانيات المتاحة.",f3:"بسيط وواضح",f3p:"بدون تعقيد، الصق الرابط واضغط تحميل.",ad:"إعلان",wait:"انتظر {n} ثوانٍ...",continue:"متابعة التحميل",footer:"TikSave © 2026 — أداة تحميل سهلة وسريعة",invalid:"يرجى إدخال رابط فيديو صحيح.",loading:"جارٍ تجهيز الفيديو..."},
en:{dir:"ltr",badge:"Fast & Easy Downloads",title:'Download videos with <span>TikSave</span>',subtitle:"Paste a video URL and get high-quality download options through a simple, fast interface.",placeholder:"Paste video URL here...",button:"Download Video",f1:"High Speed",f1p:"A lightweight interface designed for quick downloads.",f2:"Multiple Qualities",f2p:"Choose the quality that fits your video and device.",f3:"Simple & Clear",f3p:"No complexity. Paste the link and download.",ad:"Advertisement",wait:"Wait {n} seconds...",continue:"Continue Download",footer:"TikSave © 2026 — Simple & Fast Downloader",invalid:"Please enter a valid video URL.",loading:"Preparing video..."},
tr:{dir:"ltr",badge:"Hızlı ve Kolay İndirme",title:'Videolarınızı <span>TikSave</span> ile indirin',subtitle:"Video bağlantısını yapıştırın ve yüksek kaliteli indirme seçeneklerine ulaşın.",placeholder:"Video bağlantısını buraya yapıştırın...",button:"Videoyu İndir",f1:"Yüksek Hız",f1p:"Hızlı indirmeler için hafif arayüz.",f2:"Birden Fazla Kalite",f2p:"Videonuza uygun kaliteyi seçin.",f3:"Basit ve Açık",f3p:"Bağlantıyı yapıştırın ve indirin.",ad:"Reklam",wait:"{n} saniye bekleyin...",continue:"İndirmeye Devam Et",footer:"TikSave © 2026 — Basit ve Hızlı İndirici",invalid:"Geçerli bir video bağlantısı girin.",loading:"Video hazırlanıyor..."},
fr:{dir:"ltr",badge:"Téléchargement rapide et facile",title:'Téléchargez vos vidéos avec <span>TikSave</span>',subtitle:"Collez le lien vidéo et obtenez des options de téléchargement de haute qualité.",placeholder:"Collez le lien vidéo ici...",button:"Télécharger",f1:"Grande vitesse",f1p:"Une interface légère pour des téléchargements rapides.",f2:"Plusieurs qualités",f2p:"Choisissez la qualité adaptée.",f3:"Simple et clair",f3p:"Collez le lien et téléchargez.",ad:"Publicité",wait:"Attendez {n} secondes...",continue:"Continuer",footer:"TikSave © 2026 — Téléchargeur simple et rapide",invalid:"Veuillez saisir un lien vidéo valide.",loading:"Préparation de la vidéo..."},
es:{dir:"ltr",badge:"Descargas rápidas y fáciles",title:'Descarga vídeos con <span>TikSave</span>',subtitle:"Pega el enlace del vídeo y obtén opciones de descarga de alta calidad.",placeholder:"Pega el enlace del vídeo aquí...",button:"Descargar vídeo",f1:"Alta velocidad",f1p:"Interfaz ligera para descargas rápidas.",f2:"Varias calidades",f2p:"Elige la calidad adecuada.",f3:"Simple y claro",f3p:"Pega el enlace y descarga.",ad:"Publicidad",wait:"Espera {n} segundos...",continue:"Continuar",footer:"TikSave © 2026 — Descargador simple y rápido",invalid:"Introduce un enlace de vídeo válido.",loading:"Preparando vídeo..."},
de:{dir:"ltr",badge:"Schnelle und einfache Downloads",title:'Videos mit <span>TikSave</span> herunterladen',subtitle:"Videolink einfügen und hochwertige Download-Optionen erhalten.",placeholder:"Videolink hier einfügen...",button:"Video herunterladen",f1:"Hohe Geschwindigkeit",f1p:"Leichte Oberfläche für schnelle Downloads.",f2:"Mehrere Qualitäten",f2p:"Wählen Sie die passende Qualität.",f3:"Einfach und klar",f3p:"Link einfügen und herunterladen.",ad:"Werbung",wait:"Warten Sie {n} Sekunden...",continue:"Weiter zum Download",footer:"TikSave © 2026 — Einfacher und schneller Downloader",invalid:"Bitte geben Sie einen gültigen Videolink ein.",loading:"Video wird vorbereitet..."}
};

let currentLang="ar";
let pendingUrl="";
let timer=null;

function changeLanguage(lang){
currentLang=lang;
const t=translations[lang]||translations.ar;
document.documentElement.lang=lang;
document.documentElement.dir=t.dir;
document.getElementById("badge").textContent=t.badge;
document.getElementById("title").innerHTML=t.title;
document.getElementById("subtitle").textContent=t.subtitle;
document.getElementById("url").placeholder=t.placeholder;
document.getElementById("downloadBtn").textContent=t.button;
document.getElementById("f1").textContent=t.f1;
document.getElementById("f1p").textContent=t.f1p;
document.getElementById("f2").textContent=t.f2;
document.getElementById("f2p").textContent=t.f2p;
document.getElementById("f3").textContent=t.f3;
document.getElementById("f3p").textContent=t.f3p;
document.getElementById("adTitle").textContent=t.ad;
document.getElementById("tsGateBtn").textContent=t.continue;
document.getElementById("footer").textContent=t.footer;
localStorage.setItem("tiksave-lang",lang);
}

function startDownload(){
const url=document.getElementById("url").value.trim();
const t=translations[currentLang];
if(!url){
document.getElementById("result").innerHTML='<div class="card">'+t.invalid+"</div>";
return;
}
pendingUrl=url;
document.getElementById("result").innerHTML='<div class="card">'+t.loading+"</div>";
showGate();
}

function showGate(){
const gate=document.getElementById("tsGate");
const btn=document.getElementById("tsGateBtn");
const txt=document.getElementById("tsGateText");
const t=translations[currentLang];
let n=5;
gate.style.display="flex";
btn.disabled=true;
txt.textContent=t.wait.replace("{n}",n);
clearInterval(timer);
timer=setInterval(()=>{
n--;
if(n<=0){
clearInterval(timer);
txt.textContent=t.continue;
btn.disabled=false;
}else{
txt.textContent=t.wait.replace("{n}",n);
}
},1000);
}

function continueDownload(){
document.getElementById("tsGate").style.display="none";
const result=document.getElementById("result");
result.innerHTML='<div class="card">⏳ '+translations[currentLang].loading+'</div>';
setTimeout(()=>{
result.innerHTML='<div class="videoCard"><h3>TikSave</h3><p>'+pendingUrl+'</p><select class="quality"><option>1080p</option><option>720p</option><option>480p</option><option>360p</option><option>Best Quality</option></select><button class="downloadBtn" style="margin-top:12px;padding:13px 20px" onclick="alert(\'Download request sent\')">'+translations[currentLang].button+'</button><div class="clear"></div></div>';
},500);
}

document.getElementById("language").value=localStorage.getItem("tiksave-lang")||"ar";
changeLanguage(document.getElementById("language").value);
</script>
<style id="TikSaveMandatoryAd">
#tsAdGate{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:99999;align-items:center;justify-content:center;padding:20px}
#tsAdBox{width:min(440px,100%);min-height:260px;background:#fff;border-radius:24px;padding:28px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.25)}
#tsAdBox .adtitle{font-size:22px;font-weight:700;margin:10px}
#tsAdBox .adspace{height:130px;border:1px dashed #ddd;border-radius:16px;display:flex;align-items:center;justify-content:center;color:#999;margin:20px 0}
#tsAdBox button{border:0;border-radius:12px;padding:12px 24px;background:#111;color:#fff;font-size:15px;cursor:pointer}
#tsAdBox button:disabled{opacity:.45;cursor:not-allowed}
</style>
<div id="tsAdGate">
<div id="tsAdBox">
<div class="adtitle">إعلان</div>
<div class="adspace">مساحة إعلانية</div>
<div id="tsAdTimer">انتظر 5 ثوانٍ...</div>
<button id="tsAdContinue" disabled>متابعة التحميل</button>
</div>
</div>
<script>
(function(){
var gate=document.getElementById('tsAdGate');
var timer=document.getElementById('tsAdTimer');
var btn=document.getElementById('tsAdContinue');
var seconds=5;
window.tsShowAd=function(done){
gate.style.display='flex';
seconds=5;
btn.disabled=true;
timer.textContent='انتظر '+seconds+' ثوانٍ...';
var t=setInterval(function(){
seconds--;
if(seconds>0){
timer.textContent='انتظر '+seconds+' ثوانٍ...';
}else{
clearInterval(t);
timer.textContent='يمكنك المتابعة الآن';
btn.disabled=false;
}
},1000);
btn.onclick=function(){
gate.style.display='none';
if(done)done();
};
};
})();
</script></body>
</html>

